{
  "name": "funnel-analyzer",
  "version": "1.0.0",
  "description": "Playwright landing-page analysis API: URL in, structured evidence-backed analysis out",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "serve": "tsx src/server.ts",
    "analyze": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "tsx --test tests/api.test.ts tests/url_guard.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "playwright",
    "landing-page",
    "analysis",
    "api",
    "funnel"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
