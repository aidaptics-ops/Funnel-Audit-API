# Copy to .env for local development. Every variable is optional.

PORT=3000
HOST=0.0.0.0

# Analysis limits
MAX_CONCURRENT_ANALYSES=2
BROWSER_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=30000
ANALYSIS_TIMEOUT_MS=120000

# Leave empty to use the bundled Chromium (what the Docker image ships).
# Set to "chrome" to drive a locally installed Chrome instead.
BROWSER_CHANNEL=
HEADLESS=true

# Mobile-viewport pass. Reads mobile overflow/viewport facts, but costs a
# second page load — set false to roughly halve analysis time.
CHECK_MOBILE_VIEWPORT=true

# Same-origin link checking
CHECK_LINKS=true
MAX_LINK_CHECKS=25

# LOCAL TESTING ONLY. Allows localhost and private IP ranges through the SSRF
# guard. Never enable this on a deployed instance.
ALLOW_PRIVATE_HOSTS=false

LOG_LEVEL=info
